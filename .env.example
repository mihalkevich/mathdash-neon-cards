# Server (only used by server.ts — not needed on Vercel)
PORT=3000
NODE_ENV=development

# Supabase (client via VITE_ prefix). Optional: without these the game
# stores history and leaderboard in localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Multiplayer requires the WebSocket server in server.ts to be running as a
# persistent process. Leave unset on serverless hosts such as Vercel — the
# mode is hidden instead of failing at runtime.
VITE_ENABLE_MULTIPLAYER=
